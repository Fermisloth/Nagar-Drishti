# NagarDrishti — Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

PROJECT_NAME="NagarDrishti AI Engine"
ENV="development"
PORT=8000

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=[REDACTED]
POSTGRES_PASSWORD=[REDACTED]
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=[REDACTED]

# ── Gemini AI ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=[REDACTED]

# ── Qdrant Vector Store ────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=complaint_embeddings

# ── JWT Security ───────────────────────────────────────────────────────────
# Generate strong random secrets: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=[REDACTED]
JWT_REFRESH_SECRET_KEY=[REDACTED]
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Argon2 Parameters ─────────────────────────────────────────────────────
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=102400

# ── Application Settings ──────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]
MAX_UPLOAD_SIZE_BYTES=5242880

# ── Embedding / AI Model Config ───────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_VERSION=v1
GEMINI_GENERATION_MODEL=gemini-1.5-flash
PROMPT_VERSION=v1

# ── Decision Engine Thresholds ────────────────────────────────────────────
DECISION_SIMILARITY_THRESHOLD=0.82
DECISION_DISTANCE_METERS_THRESHOLD=500.0
DECISION_RECENCY_DAYS_THRESHOLD=30
